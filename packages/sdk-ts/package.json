{
  "name": "@kestrel/sdk",
  "version": "1.0.1",
  "license": "Apache-2.0",
  "description": "TypeScript client for Kestrel, open-source cloud browsers for AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vedantxn/kestrel.git",
    "directory": "packages/sdk-ts"
  },
  "homepage": "https://github.com/vedantxn/kestrel#readme",
  "bugs": "https://github.com/vedantxn/kestrel/issues",
  "keywords": [
    "browser",
    "chrome",
    "cdp",
    "playwright",
    "puppeteer",
    "ai-agents",
    "headless",
    "self-hosted"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/test"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run",
    "prepublishOnly": "tsc -b"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kestrel/contracts": "*",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
